generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  WATER_OUTAGE
  STREET_LEAK
  SERVICE_LINE_LEAK
  SEWAGE
  LOW_PRESSURE
  OTHER

  @@map("category")
}

enum Status {
  OPEN
  IN_TRIAGE
  TEAM_ASSIGNED
  IN_FIELD
  RESOLVED
  CLOSED
  REOPENED

  @@map("status")
}

enum AdminRole {
  ADMIN
  OPERATOR

  @@map("admin_role")
}

enum ServiceAreaLevel {
  CITY
  STATE
  COUNTRY

  @@map("service_area_level")
}

enum MediaType {
  PHOTO
  VIDEO

  @@map("media_type")
}

enum NotificationRecipient {
  CITIZEN
  ADMIN

  @@map("notification_recipient")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  /// Service area restriction: which localities this tenant accepts service
  /// requests from. Null level = unrestricted (validation happens in C8).
  serviceAreaLevel  ServiceAreaLevel? @map("service_area_level")
  serviceAreaValues String[]          @default([]) @map("service_area_values")
  /// WhatsApp number that receives "new service request" alerts (E4).
  /// Null = admin notifications disabled for this tenant.
  notificationPhone String?  @map("notification_phone")
  createdAt         DateTime @default(now()) @map("created_at")

  serviceRequests ServiceRequest[]
  media           Media[]
  statusEvents    StatusEvent[]
  adminUsers      AdminUser[]
  notifications   Notification[]

  @@map("tenants")
}

model ServiceRequest {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  protocol    String   @unique
  category    Category
  description String
  status      Status   @default(OPEN)
  latitude    Float
  longitude   Float
  /// PostGIS point kept in sync by the application (see migration add_postgis)
  location    Unsupported("geography(Point, 4326)")?
  addressText String?  @map("address_text")
  /// Locality resolved by reverse geocoding at creation time (B9); nullable
  /// because the geocoder may be unavailable. Used for filters and the
  /// service-area validation (C8/G8).
  city    String?
  state   String?
  country String?
  /// PII stored in plain text by design: the admin queue requires free
  /// search/sort on these fields (spec §9). Protected by RLS + access control.
  reporterName  String   @map("reporter_name")
  reporterPhone String   @map("reporter_phone")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  media         Media[]
  statusEvents  StatusEvent[]
  notifications Notification[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, createdAt])
  @@index([tenantId, city])
  @@index([tenantId, state])
  @@map("service_requests")
}

model Media {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  serviceRequestId String    @map("service_request_id") @db.Uuid
  type             MediaType @default(PHOTO)
  /// Path inside the private storage bucket — never a public URL.
  /// Served exclusively through short-lived signed URLs (I5).
  storagePath String @map("storage_path")
  mimeType    String @map("mime_type")
  sizeBytes   Int    @map("size_bytes")
  /// Only for VIDEO (≤ 10s per product rule C9).
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@index([tenantId])
  @@index([serviceRequestId])
  @@map("media")
}

model StatusEvent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  serviceRequestId String   @map("service_request_id") @db.Uuid
  previousStatus   Status?  @map("previous_status")
  newStatus        Status   @map("new_status")
  comment          String?
  author           String
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@index([tenantId])
  @@index([serviceRequestId, createdAt])
  @@map("status_events")
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clerkUserId String    @unique @map("clerk_user_id")
  role        AdminRole @default(OPERATOR)
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("admin_users")
}

/// Outbound WhatsApp notification audit + idempotency ledger (E5). One row
/// per (event, recipient); the unique constraint makes redeliveries no-ops.
/// Stores NO phone number — PII stays on ServiceRequest; the recipient is a
/// role and the number is resolved at send time.
model Notification {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  serviceRequestId String                @map("service_request_id") @db.Uuid
  /// Stable id of the domain event that triggered this notification.
  eventId   String                @map("event_id")
  eventType String                @map("event_type")
  recipient NotificationRecipient
  status    NotificationStatus    @default(PENDING)
  /// Provider message id returned by the Evolution API on success.
  providerMessageId String?  @map("provider_message_id")
  error             String?
  attempts          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@unique([tenantId, eventId, recipient])
  @@index([tenantId])
  @@index([serviceRequestId])
  @@map("notifications")
}
