{
  "name": "@org/mobile",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": ["scope:mobile"],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/mobile",
          "command": "expo export"
        },
        "outputs": [
          "{workspaceRoot}/packages/mobile/dist"
        ],
        "cache": true
      }
    }
  },
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . packages/mobile"
  },
  "dependencies": {
    "@expo/metro-config": "*",
    "@testing-library/react-native": "*",
    "expo": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "jest-expo": "*",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*"
  }
}
